# LLM — Gemini only.
# All agent reasoning (review answer drafts + probe suggestions + grading) and
# the student chat run on Gemini. There is no Ollama / multi-provider fallback.
GEMINI_API_KEY=

# Model used by the CrewAI agents (review drafts, probe suggestions, grading).
AGENT_MODEL=gemini-2.5-pro
# Model used for the direct (non-review) student chat streaming.
STUDENT_CHAT_MODEL=gemini-2.5-flash-lite

# Backend
DB_PATH=./veriexam.db
AUDIT_AES_KEY=replace-with-32-byte-base64-key

# Dev/debug: if set, the student app skips the login prompt and auto-logs in
# with this code. Leave empty in production.
DEV_AUTO_LOGIN_CODE=
# The teacher dashboard has its own equivalent — set VITE_DEV_AUTO_LOGIN_CODE
# in dashboard/.env.local (see dashboard/.env.example) to auto-login there.

# CLion plugin behavior (ignored by the Chainlit web client).
#   chat — faithful chat port: login + briefing + streaming chat + probes.
#   ide  — IDE-native: everything in `chat` PLUS scaffolds the assigned
#          variant's starter C file into the open project and shows the
#          variant's required test inputs as a checklist.
STUDENT_CLIENT_MODE=chat
# File the `ide` mode scaffolds into the student's project.
SCAFFOLD_FILENAME=mcalc.c

# --- Exam / proctor mode (CLion plugin only) ---
# When EXAM_MODE is on, the plugin reports to the backend every time a student
# leaves CLion (minimizes, switches app, or exits full screen). The teacher
# dashboard flags those students in real time. FULLSCREEN makes the plugin put
# CLion in full screen at exam start and re-assert it if they leave.
# Both default to ON whenever STUDENT_CLIENT_MODE=ide; set them explicitly to
# force the behavior regardless of mode. Leave blank to use the default.
EXAM_MODE=
FULLSCREEN=

# How often the IDE plugin polls for instructor probes, in ms (default 2000).
# Every poll is one HTTP request; on ngrok's free tier (20k requests/month) use
# 10000 so a class session fits the cap.
POLL_INTERVAL_MS=

# LLM provider for the student chat AND the agents: gemini (default) or anthropic.
# With anthropic, set ANTHROPIC_API_KEY; CLAUDE_MODEL picks the model.
LLM_PROVIDER=
CLAUDE_MODEL=claude-sonnet-5-5

# Instructor (teacher) accounts can sign in and act only from this machine's
# local dashboard, never through the tunnel. Set to false to allow remote use
# (e.g. running veriexam_plugin/publish.sh from the JDK-21 build machine).
TEACHER_LOCAL_ONLY=true
