# LLM — Gemini only.
# All agent reasoning (review answer drafts + probe suggestions + grading) and
# the student chat run on Gemini. There is no Ollama / multi-provider fallback.
GEMINI_API_KEY=

# Model used by the CrewAI agents (review drafts, probe suggestions, grading).
AGENT_MODEL=gemini-2.5-pro
# Model used for the direct (non-review) student chat streaming.
STUDENT_CHAT_MODEL=gemini-2.5-flash-lite

# Backend
DB_PATH=./veriexam.db
AUDIT_AES_KEY=replace-with-32-byte-base64-key

# Dev/debug: if set, the student app skips the login prompt and auto-logs in
# with this code. Leave empty in production.
DEV_AUTO_LOGIN_CODE=
# The teacher dashboard has its own equivalent — set VITE_DEV_AUTO_LOGIN_CODE
# in dashboard/.env.local (see dashboard/.env.example) to auto-login there.
# (Auto-login uses the default password, the code itself.)

# Optional: the student web app shows Chainlit's own login page (hidden password
# field) when this is set. Make one with `chainlit create-secret`. Empty: the
# chat asks for the username and password.
CHAINLIT_AUTH_SECRET=

# CLion plugin behavior (ignored by the Chainlit web client).
#   chat — faithful chat port: login + briefing + streaming chat + probes.
#   ide  — IDE-native: everything in `chat` PLUS scaffolds the assigned
#          variant's starter C file into the open project and shows the
#          variant's required test inputs as a checklist.
STUDENT_CLIENT_MODE=chat
# File the `ide` mode scaffolds into the student's project.
SCAFFOLD_FILENAME=mcalc.c

# --- Exam / proctor mode (CLion plugin only) ---
# When EXAM_MODE is on, the plugin reports to the backend every time a student
# leaves CLion (minimizes, switches app, or exits full screen). The teacher
# dashboard flags those students in real time. FULLSCREEN makes the plugin put
# CLion in full screen at exam start and re-assert it if they leave.
# Both default to ON whenever STUDENT_CLIENT_MODE=ide; set them explicitly to
# force the behavior regardless of mode. Leave blank to use the default.
EXAM_MODE=
FULLSCREEN=
# Keep the IDE window maximized during the exam and report a smaller window;
# on Windows also report any other app in front (plugin 0.4.1+). Defaults to
# EXAM_MODE.
EXAM_MAXIMIZED=

# How often the IDE plugin polls for instructor probes, in ms (default 2000).
# Every poll is one HTTP request; on ngrok's free tier (20k requests/month) use
# 10000 so a class session fits the cap.
POLL_INTERVAL_MS=

# LLM provider for the student chat AND the agents: gemini (default) or anthropic.
# With anthropic, set ANTHROPIC_API_KEY; CLAUDE_MODEL picks the model.
LLM_PROVIDER=
CLAUDE_MODEL=claude-sonnet-5-5

# "Ask again": a tutor reply gets a "Not detailed enough? Ask Sonnet 5.5" button
# that sends the same question to this stronger model (needs ANTHROPIC_API_KEY,
# whatever LLM_PROVIDER is). Empty turns the button off. Off while review mode is on.
CLAUDE_STRONG_MODEL=claude-sonnet-5-5
# Cache of those answers: the same question asked in the same context (exercise,
# variant, mode, lab step, earlier turns) is answered from the cache, with no
# new API call. ANSWER_CACHE_DAYS=0 keeps answers until cleared:
#   sqlite3 veriexam.db "DELETE FROM answer_cache"
ANSWER_CACHE=true
ANSWER_CACHE_DAYS=30

# Review queue: each question gets four drafted answers (nudge, normal, more and
# a direct, non-Socratic one) in English and Hebrew. The teacher can have them
# drafted again with CLAUDE_STRONG_MODEL (above) or with this, the smartest model.
# Both need ANTHROPIC_API_KEY. Empty turns the "Opus" button off.
CLAUDE_BEST_MODEL=claude-opus-5-5
# How long the drafting may take (eight texts in one call), and its token budget.
TUTOR_TIMEOUT_SEC=120
TUTOR_MAX_TOKENS=8192

# Question bank (faq.yaml in an exercise package): a student's question this close
# to a bank question (0..1) shows the bank's ready answer in the teacher's queue.
BANK_MATCH_THRESHOLD=0.45
# With review mode off, answer a question at least BANK_AUTO_THRESHOLD close
# straight from the bank, with no model call.
BANK_AUTO_ANSWER=false
BANK_AUTO_THRESHOLD=0.8

# Instructor (teacher) accounts can sign in and act only from this machine's
# local dashboard, never through the tunnel. Set to false to allow remote use
# (e.g. running veriexam_plugin/publish.sh from the JDK-21 build machine).
TEACHER_LOCAL_ONLY=true

# Lock an IP out for 5 minutes after 4 failed logins. Off by default: a whole
# class usually shares one outgoing IP, so a few typos would block everyone.
LOGIN_RATE_LIMIT=false
