# Cloud LLM (instructor-side question suggestions only).
# Pick the provider matching config/cloud_llm.yaml and set its key.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# Student-facing LLM backend. DEFAULT: ollama (privacy preserved).
# Set to "gemini" ONLY for dev/debugging — student messages leave the machine.
STUDENT_LLM=ollama
STUDENT_LLM_MODEL=gemini-2.5-flash-lite

# Backend
DB_PATH=./oslab.db
AUDIT_AES_KEY=replace-with-32-byte-base64-key

# Dev/debug: if set, the student app skips the login prompt and auto-logs in
# with this code. Leave empty in production.
DEV_AUTO_LOGIN_CODE=
