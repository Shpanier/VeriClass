# Teacher dashboard (Vite) — copy to .env.local for local dev.
# Only VITE_-prefixed vars are exposed to the browser bundle.

# Dev/debug: if set AND Vite runs in dev mode (`npm run dev`), the dashboard
# skips the instructor sign-in form and auto-logs in with this teacher code.
# It also shows the code on the login screen. Mirrors the student app's
# DEV_AUTO_LOGIN_CODE. Never leaks to production builds. Leave empty otherwise.
VITE_DEV_AUTO_LOGIN_CODE=
